@startuml

package "8-Puzzle A* Solver" {
  [UserInterface]
  [Experiment]
  [AStarSolver]
  [RandomGenerator]
  [Mechanics]
  [Heuristics]

  UserInterface --> RandomGenerator : generateRandomSolvableBoard()
  UserInterface --> Heuristics : imports hamming(), manhattan()
  UserInterface --> AStarSolver : calls a_star(start, goal, heuristic)
  UserInterface --> Experiment : runs ui_benchmark()
  Experiment --> RandomGenerator : generates test boards
  Experiment --> Heuristics : uses both heuristics
  Experiment --> AStarSolver : runs solver repeatedly
  AStarSolver --> Mechanics : uses neighbors(), is_solvable()
  AStarSolver --> Heuristics : calls h(n) in calculateCosts()
  RandomGenerator --> Mechanics : uses neighbors() to scramble, is_solvable() to check validity

}

[statisticsLib]
Experiment --> statisticsLib : mean(), stdev()

@enduml
